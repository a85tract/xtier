# Build artifacts (kernel module / eBPF / loader)
*.o
*.o.bc
*.bc
*.ko
*.mod
*.mod.c
*.cmd
.tmp_versions/
Module.symvers
modules.order
src/page_profiler_user
src/xtier_executor

# libbpf headers staged out of the kernel tree by `make`.
src/.libbpf-include/

# Generated by `make` from the running kernel's BTF. Machine-specific;
# regenerate rather than commit. See README.md.
vmlinux.h

# Experiment output. Results are not distributed with this repository --
# figures/ carries the data behind each published figure, and everything
# else is meant to be regenerated. See docs/SETUP.md.
results/
outputs/
*.log
*.out
*.dat
*.numa_maps
*.profiler

# Trained model blobs. ml/models/*.h is the exported form and IS tracked.
*.npz
*.pt
*.pth
*.onnx
*.ckpt
*.model
model_stats.txt

# Figure output. The plot scripts write these; the inputs are tracked.
figures/**/*.png
figures/**/*.pdf

# Python
__pycache__/
*.pyc
.venv/

# Debug / perf
perf.data*
core
vgcore.*

# Editor and OS
*~
*.swp
*.swo
*.bak
*.orig
*.tmp
.DS_Store

+    else
+	return pebs_inst_period_list[pinstcount - 1];
+}
+
+static inline void increase_sample_period(unsigned long *llc_period,
+					  unsigned long *inst_period) {
+    unsigned long p;
+    p = *llc_period;
+    if (++p < pcount)
+	*llc_period = p;
+
+    p = *inst_period;
+    if (++p < pinstcount)
+	*inst_period = p;

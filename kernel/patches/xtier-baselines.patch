+// SPDX-License-Identifier: GPL-2.0
+/*
+ * htmm_sysfs.c - HTMM tunable variables + /sys/kernel/mm/htmm/* interface
+ *
+ * Reconstructed from a BTF dump and /proc/kallsyms symbol names of a
+ * running HTMM 6.11 kernel; defaults match that kernel's sysfs values.
+ */
+#include <linux/kobject.h>
+#include <linux/sysfs.h>
+#include <linux/init.h>
+#include <linux/mm.h>
+#include <linux/htmm.h>
+
+/* === HTMM tunable variable definitions === */
+unsigned int htmm_sample_period         = 199;
+unsigned int htmm_inst_sample_period    = 100007;
+unsigned int htmm_thres_hot             = 0;
+unsigned int htmm_cooling_period        = 1000;
+unsigned int htmm_adaptation_period     = 100000;
+unsigned int htmm_demotion_period_in_ms = 500;
+unsigned int htmm_promotion_period_in_ms = 500;
+unsigned int htmm_mode                  = 1; /* HTMM_BASELINE */
+unsigned int htmm_nowarm                = 1;
+bool         htmm_cxl_mode              = false;
+unsigned int htmm_gamma                 = 4;
+bool         htmm_skip_cooling          = false;
+unsigned int htmm_thres_cooling_alloc   = 2621440;
+unsigned int ksampled_soft_cpu_quota    = 30;
+unsigned int ksampled_max_sample_ratio  = 10;
+unsigned int ksampled_min_sample_ratio  = 50;
+EXPORT_SYMBOL(htmm_sample_period);
+EXPORT_SYMBOL(htmm_inst_sample_period);
+EXPORT_SYMBOL(htmm_thres_hot);
+EXPORT_SYMBOL(htmm_cooling_period);
+EXPORT_SYMBOL(htmm_adaptation_period);
+EXPORT_SYMBOL(htmm_demotion_period_in_ms);
+EXPORT_SYMBOL(htmm_promotion_period_in_ms);
+EXPORT_SYMBOL(htmm_mode);
+EXPORT_SYMBOL(htmm_nowarm);
+EXPORT_SYMBOL(htmm_cxl_mode);
+EXPORT_SYMBOL(htmm_gamma);
+EXPORT_SYMBOL(htmm_skip_cooling);
+EXPORT_SYMBOL(htmm_thres_cooling_alloc);
+EXPORT_SYMBOL(ksampled_soft_cpu_quota);
+EXPORT_SYMBOL(ksampled_max_sample_ratio);
+EXPORT_SYMBOL(ksampled_min_sample_ratio);
+
+/* === sysfs show/store helpers === */
+#define HTMM_UINT_RW(name)							\
+static ssize_t name##_show(struct kobject *kobj, struct kobj_attribute *attr,	\
+			   char *buf)						\
+{										\
+	return sprintf(buf, "%u\n", name);					\
+}										\
+static ssize_t name##_store(struct kobject *kobj, struct kobj_attribute *attr,	\
+			    const char *buf, size_t count)			\
+{										\
+	unsigned int v;								\
+	if (kstrtouint(buf, 0, &v))						\
+		return -EINVAL;							\
+	name = v;								\
+	return count;								\
+}										\
+static struct kobj_attribute name##_attr = __ATTR(name, 0644, name##_show, name##_store);
+
+#define HTMM_BOOL_RW(name)							\
+static ssize_t name##_show(struct kobject *kobj, struct kobj_attribute *attr,	\
+			   char *buf)						\
+{										\
+	return sprintf(buf, "%s\n", name ? "enabled" : "disabled");		\
+}										\
+static ssize_t name##_store(struct kobject *kobj, struct kobj_attribute *attr,	\
+			    const char *buf, size_t count)			\
+{										\
+	char tmp[16];								\
+	size_t n = min_t(size_t, count, sizeof(tmp) - 1);			\
+	memcpy(tmp, buf, n); tmp[n] = 0;					\
+	strim(tmp);								\
+	if (!strcmp(tmp, "enabled"))  name = true;				\
+	else if (!strcmp(tmp, "disabled")) name = false;			\
+	else return -EINVAL;							\
+	return count;								\
+}										\
+static struct kobj_attribute name##_attr = __ATTR(name, 0644, name##_show, name##_store);
+
+HTMM_UINT_RW(htmm_sample_period)
+HTMM_UINT_RW(htmm_inst_sample_period)
+HTMM_UINT_RW(htmm_thres_hot)
+HTMM_UINT_RW(htmm_cooling_period)
+HTMM_UINT_RW(htmm_adaptation_period)
+HTMM_UINT_RW(htmm_demotion_period_in_ms)
+HTMM_UINT_RW(htmm_promotion_period_in_ms)
+HTMM_UINT_RW(htmm_mode)
+HTMM_UINT_RW(htmm_nowarm)
+HTMM_UINT_RW(htmm_gamma)
+HTMM_UINT_RW(htmm_thres_cooling_alloc)
+HTMM_UINT_RW(ksampled_soft_cpu_quota)
+HTMM_UINT_RW(ksampled_max_sample_ratio)
+HTMM_UINT_RW(ksampled_min_sample_ratio)
+HTMM_BOOL_RW(htmm_cxl_mode)
+HTMM_BOOL_RW(htmm_skip_cooling)
+
+static struct attribute *htmm_attrs[] = {
+	&htmm_sample_period_attr.attr,
+	&htmm_inst_sample_period_attr.attr,
+	&htmm_thres_hot_attr.attr,
+	&htmm_cooling_period_attr.attr,
+	&htmm_adaptation_period_attr.attr,
+	&htmm_demotion_period_in_ms_attr.attr,
+	&htmm_promotion_period_in_ms_attr.attr,
+	&htmm_mode_attr.attr,
+	&htmm_nowarm_attr.attr,
+	&htmm_gamma_attr.attr,
+	&htmm_thres_cooling_alloc_attr.attr,
+	&ksampled_soft_cpu_quota_attr.attr,
+	&ksampled_max_sample_ratio_attr.attr,
+	&ksampled_min_sample_ratio_attr.attr,
+	&htmm_cxl_mode_attr.attr,
+	&htmm_skip_cooling_attr.attr,
+	NULL,
+};
+
+static const struct attribute_group htmm_attr_group = {
+	.attrs = htmm_attrs,
+};
+
+extern int kmigraterd_init(void);
+extern int ksampled_init(void);
+
+static int __init htmm_sysfs_init(void)
+{
+	struct kobject *htmm_kobj;
+	int err;
+
+	htmm_kobj = kobject_create_and_add("htmm", mm_kobj);
+	if (!htmm_kobj) {
+		pr_err("htmm: failed to create /sys/kernel/mm/htmm\n");
+		return -ENOMEM;
+	}
+	err = sysfs_create_group(htmm_kobj, &htmm_attr_group);
+	if (err) {
+		pr_err("htmm: sysfs_create_group failed: %d\n", err);
+		kobject_put(htmm_kobj);
+		return err;
+	}
+	/* Start the kmigraterd kthreads (one per NUMA node) */
+	kmigraterd_init();
+	pr_info("htmm: sysfs initialized; kmigraterd started\n");
+	return 0;
+}
+late_initcall(htmm_sysfs_init);

+
+static int memcg_htmm_show(struct seq_file *m, void *v)
+{
+	struct mem_cgroup *memcg = mem_cgroup_from_css(seq_css(m));
+	seq_printf(m, "%s\n", memcg->htmm_enabled ? "enabled" : "disabled");
+	return 0;
+}
+
+static ssize_t memcg_htmm_write(struct kernfs_open_file *of, char *buf,
+				 size_t nbytes, loff_t off)
+{
+	struct mem_cgroup *memcg = mem_cgroup_from_css(of_css(of));
+	int nid;
+
+	buf = strstrip(buf);
+	if (!strcmp(buf, "enabled")) {
+		if (!memcg->htmm_enabled) {
+			memcg->htmm_enabled = true;
+			memcg->cooling_clock = 1;
+			spin_lock_init(&memcg->access_lock);
+			for_each_node_state(nid, N_MEMORY)
+				add_memcg_to_kmigraterd(memcg, nid);
+		}
+	} else if (!strcmp(buf, "disabled")) {
+		if (memcg->htmm_enabled) {
+			memcg->htmm_enabled = false;
+			for_each_node_state(nid, N_MEMORY)
+				del_memcg_from_kmigraterd(memcg, nid);
+		}
+	} else {
+		return -EINVAL;
+	}
+	return nbytes;
+}
+
+static int memcg_htmm_max_at_node_show(struct seq_file *m, void *v)
+{
+	struct mem_cgroup *memcg = mem_cgroup_from_css(seq_css(m));
+	seq_printf(m, "0 %lu\n", memcg->max_nr_dram_pages);
+	return 0;
+}
+
+static ssize_t memcg_htmm_max_at_node_write(struct kernfs_open_file *of, char *buf,
+				 size_t nbytes, loff_t off)
+{
+	struct mem_cgroup *memcg = mem_cgroup_from_css(of_css(of));
+	int node;
+	unsigned long pages;
+
+	buf = strstrip(buf);
+	if (sscanf(buf, "%d %lu", &node, &pages) != 2)
+		return -EINVAL;
+	if (node != 0)
+		return -EINVAL;  /* only node-0 cap supported */
+	memcg->max_nr_dram_pages = pages;
+	return nbytes;
+}

+#ifdef CONFIG_HTMM
+/*
+ * htmm__perf_event_init - allocate and attach a ring buffer to a
+ * kernel-created perf event.
+ *
+ * Memtis' PEBS sampler (mm/htmm_sampler.c) creates its perf events from
+ * kernel context, so userspace never calls mmap() on them and nothing ever
+ * allocates event->rb -- the PEBS records would have nowhere to land.  This
+ * does what perf_mmap() would normally do for a userspace-opened event.
+ *
+ * This must live in this file: rb_alloc() is private to kernel/events/ and
+ * ring_buffer_attach() is static here.
+ *
+ * Reconstructed 2026-08-24; the original patch to this file was lost.
+ */
+int htmm__perf_event_init(struct perf_event *event, unsigned long nr_pages)
+{
+	struct perf_buffer *rb;
+
+	if (!event || !nr_pages)
+		return -EINVAL;
+
+	/* idempotent: a buffer is already attached */
+	if (rcu_access_pointer(event->rb))
+		return 0;
+
+	rb = rb_alloc(nr_pages,
+		      event->attr.watermark ? event->attr.wakeup_watermark : 0,
+		      event->cpu, 0);
+	if (!rb)
+		return -ENOMEM;
+
+	ring_buffer_attach(event, rb);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(htmm__perf_event_init);
+#endif /* CONFIG_HTMM */

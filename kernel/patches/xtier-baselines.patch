+
+static inline void decrease_sample_period(unsigned long *llc_period,
+					  unsigned long *inst_period) {
+    unsigned long p;
+    p = *llc_period;
+    if (p > 0)
+	*llc_period = p - 1;
+
+    p = *inst_period;
+    if (p > 0)
+	*inst_period = p - 1;

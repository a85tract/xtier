+/* Hash table for per-page access tracking.
+ * We cannot use page->private because it is used by swap/buffer subsystems.
+ * Instead, use a small hash table keyed by PFN. */
+#define HTMM_HASH_BITS 16
+static DEFINE_HASHTABLE(htmm_access_ht, HTMM_HASH_BITS);
+static DEFINE_SPINLOCK(htmm_ht_lock);
+
+struct htmm_page_info {
+    struct hlist_node node;
+    unsigned long pfn;
+    unsigned int accesses;
+    unsigned int cooling_clock;
+};
+
+static struct htmm_page_info *htmm_find_or_create(unsigned long pfn)
+{
+    struct htmm_page_info *info;
+    unsigned long flags;
+
+    hash_for_each_possible(htmm_access_ht, info, node, pfn) {
+	if (info->pfn == pfn)
+	    return info;
+    }
+
+    info = kmalloc(sizeof(*info), GFP_ATOMIC);
+    if (!info)
+	return NULL;
+    info->pfn = pfn;
+    info->accesses = 0;
+    info->cooling_clock = 0;
+    spin_lock_irqsave(&htmm_ht_lock, flags);
+    hash_add(htmm_access_ht, &info->node, pfn);
+    spin_unlock_irqrestore(&htmm_ht_lock, flags);
+    return info;
+}
+
+
+void htmm_mm_init(struct mm_struct *mm)
+{
+    mm->htmm_enabled = false;
+}
+
+void htmm_mm_exit(struct mm_struct *mm)
+{
+    /* nothing to do for base-page only */
+}
+
+unsigned int get_accesses_from_idx(unsigned int idx)
+{
+    unsigned int accesses = 1;
+
+    if (idx == 0)
+	return 0;
+
+    while (idx--)
+	accesses <<= 1;
+
+    return accesses;
+}
+
+unsigned int get_idx(unsigned long num)
+{
+    unsigned int cnt = 0;
+
+    num++;
+    while (1) {
+	num = num >> 1;
+	if (num)
+	    cnt++;
+	else
+	    return cnt;
+
+	if (cnt == 15)
+	    break;
+    }
+
+    return cnt;
+}
+
+int get_skew_idx(unsigned long num)
+{
+    int cnt = 0;
+    unsigned long tmp;
+
+    tmp = num;
+    if (tmp >= 1024) {
+	while (tmp > 1024 && cnt < 9) {
+	    tmp -= 1024;
+	    cnt++;
+	}
+	cnt += 11;
+    } else {
+	while (tmp) {
+	    tmp >>= 1;
+	    cnt++;
+	}
+    }
+
+    return cnt;
+}
+
+/*
+ * cooling_page - check cooling status for a base page
+ *
+ * In the simplified base-page-only version, we track hotness using
+ * PageActive flag and per-page accesses stored in page->private.
+ *
+ * Returns:
+ *   0 = page was not cooled (cooling clock hasn't advanced)
+ *   1 = page was cooled and is now cold
+ *   2 = page was cooled but is still hot
+ */
+int cooling_page(struct page *page, struct mem_cgroup *memcg)
+{
+    unsigned long accesses, cur_idx;
+    unsigned int memcg_cclock;
+    unsigned int page_cclock;
+    struct htmm_page_info *info;
+
+    if (!memcg || !memcg->htmm_enabled)
+	return 0;
+
+    info = htmm_find_or_create(page_to_pfn(page));
+    if (!info)
+	return 0;
+
+    memcg_cclock = READ_ONCE(memcg->cooling_clock);
+    page_cclock = info->cooling_clock;
+
+    if (memcg_cclock <= page_cclock)
+	return 0;
+
+    accesses = info->accesses;
+    /*
+     * HTMM cooling-decay clamp (2026-08-24). A page idle for >= 64 cooling
+     * periods shifts by >= 64, which is undefined behaviour; x86 masks the
+     * shift count to & 63, so the decay WRAPS -- the coldest pages keep
+     * their full access count and then rank as hot. Saturate to 0 instead.
+     */
+    {
+	unsigned int __diff = memcg_cclock - page_cclock;
+
+	accesses = (__diff >= BITS_PER_LONG) ? 0 : (accesses >> __diff);
+    }
+
+    info->accesses = accesses;
+    info->cooling_clock = memcg_cclock;
+
+    cur_idx = get_idx(accesses);
+
+    spin_lock(&memcg->access_lock);
+    memcg->hotness_hg[cur_idx]++;
+    memcg->ebp_hotness_hg[cur_idx]++;
+    spin_unlock(&memcg->access_lock);
+
+    if (cur_idx >= memcg->active_threshold)
+	return 2; /* still hot */
+    return 1; /* now cold */
+}
+
+/*
+ * page_check_hotness - check if page should be on active or inactive LRU
+ * Returns:
+ *   0 = not checked
+ *   1 = cold
+ *   2 = hot
+ */
+int page_check_hotness(struct page *page, struct mem_cgroup *memcg)
+{
+    unsigned long accesses;
+    unsigned int cur_idx;
+
+    if (!memcg || !memcg->htmm_enabled)
+	return 0;
+
+    {
+	struct htmm_page_info *info = htmm_find_or_create(page_to_pfn(page));
+	accesses = info ? info->accesses : 0;
+    }
+    cur_idx = get_idx(accesses);
+
+    if (cur_idx >= memcg->active_threshold)
+	return 2;
+    return 1;
+}
+
+void move_page_to_active_lru(struct page *page)
+{
+    struct folio *folio = page_folio(page);
+
+    if (folio_test_active(folio))
+	return;
+
+    folio_set_active(folio);
+    /* Let the LRU machinery handle the actual move on next reclaim scan */
+}
+
+void move_page_to_inactive_lru(struct page *page)
+{
+    struct folio *folio = page_folio(page);
+
+    if (!folio_test_active(folio))
+	return;
+
+    folio_clear_active(folio);
+    folio_set_workingset(folio);
+}
+
+void set_lru_adjusting(struct mem_cgroup *memcg, bool inc_thres)
+{
+    struct mem_cgroup_per_node *pn;
+    int nid;
+
+    for_each_node_state(nid, N_MEMORY) {
+	pn = memcg->nodeinfo[nid];
+	if (!pn)
+	    continue;
+
+	WRITE_ONCE(pn->need_adjusting, true);
+	if (inc_thres)
+	    WRITE_ONCE(pn->need_adjusting_all, true);
+    }
+}
+
+static bool need_cooling(struct mem_cgroup *memcg)
+{
+    struct mem_cgroup_per_node *pn;
+    int nid;
+
+    for_each_node_state(nid, N_MEMORY) {
+	pn = memcg->nodeinfo[nid];
+	if (!pn)
+	    continue;
+
+	if (READ_ONCE(pn->need_cooling))
+	    return true;
+    }
+    return false;
+}
+
+static void set_lru_cooling(struct mm_struct *mm)
+{
+    struct mem_cgroup *memcg = get_mem_cgroup_from_mm(mm);
+    struct mem_cgroup_per_node *pn;
+    int nid;
+
+    if (!memcg || !memcg->htmm_enabled)
+	return;
+
+    for_each_node_state(nid, N_MEMORY) {
+	pn = memcg->nodeinfo[nid];
+	if (!pn)
+	    continue;
+
+	WRITE_ONCE(pn->need_cooling, true);
+    }
+}
+
+/* reset histograms and stats */
+static void reset_memcg_stat(struct mem_cgroup *memcg)
+{
+    int i;
+
+    for (i = 0; i < 16; i++) {
+	memcg->hotness_hg[i] = 0;
+	memcg->ebp_hotness_hg[i] = 0;
+    }
+
+    for (i = 0; i < 21; i++)
+	memcg->access_map[i] = 0;
+
+    memcg->sum_util = 0;
+    memcg->num_util = 0;
+}
+
+static bool __cooling(struct mm_struct *mm, struct mem_cgroup *memcg)
+{
+    int nid;
+
+    /* check whether the previous cooling is done or not */
+    for_each_node_state(nid, N_MEMORY) {
+	struct mem_cgroup_per_node *pn = memcg->nodeinfo[nid];
+	if (pn && READ_ONCE(pn->need_cooling)) {
+	    spin_lock(&memcg->access_lock);
+	    memcg->cooling_clock++;
+	    spin_unlock(&memcg->access_lock);
+	    return false;
+	}
+    }
+
+    spin_lock(&memcg->access_lock);
+    reset_memcg_stat(memcg);
+    memcg->cooling_clock++;
+    memcg->bp_active_threshold--;
+    memcg->cooled = true;
+    smp_mb();
+    spin_unlock(&memcg->access_lock);
+    set_lru_cooling(mm);
+    return true;
+}
+
+static void __adjust_active_threshold(struct mm_struct *mm,
+				      struct mem_cgroup *memcg)
+{
+    unsigned long nr_active = 0;
+    unsigned long max_nr_pages = memcg->max_nr_dram_pages -
+	    get_memcg_promotion_watermark(memcg->max_nr_dram_pages);
+    bool need_warm = false;
+    int idx_hot, idx_bp;
+
+    spin_lock(&memcg->access_lock);
+
+    for (idx_hot = 15; idx_hot >= 0; idx_hot--) {
+	unsigned long nr_pages = memcg->hotness_hg[idx_hot];
+	if (nr_active + nr_pages > max_nr_pages)
+	    break;
+	nr_active += nr_pages;
+    }
+    if (idx_hot != 15)
+	idx_hot++;
+
+    if (nr_active < (max_nr_pages * 75 / 100))
+	need_warm = true;
+
+    nr_active = 0;
+    for (idx_bp = 15; idx_bp >= 0; idx_bp--) {
+	unsigned long nr_pages = memcg->ebp_hotness_hg[idx_bp];
+	if (nr_active + nr_pages > max_nr_pages)
+	    break;
+	nr_active += nr_pages;
+    }
+    if (idx_bp != 15)
+	idx_bp++;
+
+    spin_unlock(&memcg->access_lock);
+
+    if (idx_hot < htmm_thres_hot)
+	idx_hot = htmm_thres_hot;
+    if (idx_bp < htmm_thres_hot)
+	idx_bp = htmm_thres_hot;
+
+    if (memcg->cooled) {
+	if (idx_hot < memcg->active_threshold)
+	    if (memcg->active_threshold > 1)
+		memcg->active_threshold--;
+	if (idx_bp < memcg->bp_active_threshold)
+	    memcg->bp_active_threshold = idx_bp;
+
+	memcg->cooled = false;
+	set_lru_adjusting(memcg, true);
+    } else {
+	if (idx_hot > memcg->active_threshold) {
+	    memcg->active_threshold = idx_hot;
+	    set_lru_adjusting(memcg, true);
+	}
+	memcg->bp_active_threshold = idx_bp;
+    }
+
+    /* set warm threshold */
+    if (!htmm_nowarm) {
+	if (need_warm)
+	    memcg->warm_threshold = memcg->active_threshold - 1;
+	else
+	    memcg->warm_threshold = memcg->active_threshold;
+    } else {
+	memcg->warm_threshold = memcg->active_threshold;
+    }
+}
+
+static bool need_memcg_cooling(struct mem_cgroup *memcg)
+{
+    unsigned long usage = page_counter_read(&memcg->memory);
+    if (memcg->nr_alloc + htmm_thres_cooling_alloc <= usage) {
+	memcg->nr_alloc = usage;
+	return true;
+    }
+    return false;
+}
+
+/*
+ * update_page_accesses - update access count for a base page
+ * Uses page->private to store accesses (lower 16 bits) and cooling clock (upper 16 bits).
+ */
+static void update_page_accesses(struct page *page, struct mem_cgroup *memcg)
+{
+    unsigned long prev_accesses, prev_idx, cur_idx;
+    unsigned int memcg_cclock;
+    unsigned int page_cclock;
+    bool hot;
+    struct htmm_page_info *info;
+    unsigned long pfn = page_to_pfn(page);
+
+    info = htmm_find_or_create(pfn);
+    if (!info)
+	return;
+
+    memcg_cclock = READ_ONCE(memcg->cooling_clock);
+    page_cclock = info->cooling_clock;
+    prev_accesses = info->accesses;
+
+    if (memcg_cclock > page_cclock) {
+	unsigned int diff = memcg_cclock - page_cclock;
+
+	/* HTMM cooling-decay clamp: see the note at the cooling_page() site. */
+	prev_accesses = (diff >= BITS_PER_LONG) ? 0 : (prev_accesses >> diff);
+    }
+
+    prev_idx = get_idx(prev_accesses);
+
+    prev_accesses++;
+    if (prev_accesses > 0xFFFF)
+	prev_accesses = 0xFFFF;
+
+    cur_idx = get_idx(prev_accesses);
+
+    info->accesses = prev_accesses;
+    info->cooling_clock = memcg_cclock;
+
+    spin_lock(&memcg->access_lock);
+    if (prev_idx != cur_idx) {
+	if (memcg->hotness_hg[prev_idx] > 0)
+	    memcg->hotness_hg[prev_idx]--;
+	memcg->hotness_hg[cur_idx]++;
+
+	if (memcg->ebp_hotness_hg[prev_idx] > 0)
+	    memcg->ebp_hotness_hg[prev_idx]--;
+	memcg->ebp_hotness_hg[cur_idx]++;
+    }
+    spin_unlock(&memcg->access_lock);
+
+    hot = cur_idx >= memcg->active_threshold;
+
+    if (hot)
+	move_page_to_active_lru(page);
+    else if (PageActive(page))
+	move_page_to_inactive_lru(page);
+}
+
+static int __update_pte_pginfo(struct vm_area_struct *vma, pmd_t *pmd,
+			       unsigned long address)
+{
+    pte_t *pte, ptent;
+    spinlock_t *ptl;
+    struct page *page;
+    struct mem_cgroup *memcg;
+
+    pte = pte_offset_map_lock(vma->vm_mm, pmd, address, &ptl);
+    if (!pte)
+	return 0;
+    ptent = ptep_get(pte);
+    if (!pte_present(ptent))
+	goto pte_unlock;
+
+    page = vm_normal_page(vma, address, ptent);
+    if (!page || PageKsm(page))
+	goto pte_unlock;
+
+    page = compound_head(page);
+
+    memcg = get_mem_cgroup_from_mm(vma->vm_mm);
+    if (!memcg || !memcg->htmm_enabled)
+	goto pte_unlock;
+
+    update_page_accesses(page, memcg);
+    pte_unmap_unlock(pte, ptl);
+
+    if (htmm_cxl_mode) {
+	if (page_to_nid(page) == 0)
+	    return 1;
+	else
+	    return 2;
+    } else {
+	if (node_is_toptier(page_to_nid(page)))
+	    return 1;
+	else
+	    return 2;
+    }
+
+pte_unlock:
+    pte_unmap_unlock(pte, ptl);
+    return 0;
+}
+
+static int __update_pmd_pginfo(struct vm_area_struct *vma, pud_t *pud,
+			       unsigned long address)
+{
+    pmd_t *pmd;
+
+    pmd = pmd_offset(pud, address);
+    if (!pmd || pmd_none(*pmd))
+	return 0;
+
+    if (unlikely(pmd_bad(*pmd))) {
+	pmd_clear_bad(pmd);
+	return 0;
+    }
+
+    /* base page only -- skip PMD-mapped huge pages */
+    return __update_pte_pginfo(vma, pmd, address);
+}
+
+static int __update_pginfo(struct vm_area_struct *vma, unsigned long address)
+{
+    pgd_t *pgd;
+    p4d_t *p4d;
+    pud_t *pud;
+
+    pgd = pgd_offset(vma->vm_mm, address);
+    if (pgd_none_or_clear_bad(pgd))
+	return 0;
+
+    p4d = p4d_offset(pgd, address);
+    if (p4d_none_or_clear_bad(p4d))
+	return 0;
+
+    pud = pud_offset(p4d, address);
+    if (pud_none_or_clear_bad(pud))
+	return 0;
+
+    return __update_pmd_pginfo(vma, pud, address);
+}
+
+void update_pginfo(pid_t pid, unsigned long address, enum events e)
+{
+    struct pid *pid_struct = find_get_pid(pid);
+    struct task_struct *p = pid_struct ? pid_task(pid_struct, PIDTYPE_PID) : NULL;
+    struct mm_struct *mm = p ? p->mm : NULL;
+    struct vm_area_struct *vma;
+    struct mem_cgroup *memcg;
+    int ret;
+
+    if (htmm_mode == HTMM_NO_MIG)
+	goto put_task;
+
+    if (!mm)
+	goto put_task;
+
+    if (!mmap_read_trylock(mm))
+	goto put_task;
+
+    vma = find_vma(mm, address);
+    if (unlikely(!vma))
+	goto mmap_unlock;
+
+    if (!vma->vm_mm || !vma_migratable(vma) ||
+	(vma->vm_file && (vma->vm_flags & (VM_READ | VM_WRITE)) == (VM_READ)))
+	goto mmap_unlock;
+
+    memcg = get_mem_cgroup_from_mm(mm);
+    if (!memcg || !memcg->htmm_enabled)
+	goto mmap_unlock;
+
+    ret = __update_pginfo(vma, address);
+    if (ret == 1) { /* DRAM access */
+	memcg->nr_sampled++;
+	memcg->nr_dram_sampled++;
+	memcg->nr_max_sampled++;
+    } else if (ret == 2) { /* CXL/NVM access */
+	memcg->nr_sampled++;
+	memcg->nr_max_sampled++;
+    } else
+	goto mmap_unlock;
+
+    /* cooling */
+    if (memcg->nr_sampled % htmm_cooling_period == 0 ||
+	need_memcg_cooling(memcg)) {
+	if (__cooling(mm, memcg)) {
+	    memcg->prev_dram_sampled >>= 1;
+	    memcg->prev_dram_sampled += memcg->nr_dram_sampled;
+	    memcg->nr_dram_sampled = 0;
+
+	    memcg->prev_max_dram_sampled >>= 1;
+	    memcg->prev_max_dram_sampled += memcg->max_dram_sampled;
+	    memcg->max_dram_sampled = 0;
+
+	    printk("htmm: total_accesses: %lu max_dram_hits: %lu cur_hits: %lu\n",
+		   memcg->nr_max_sampled, memcg->prev_max_dram_sampled,
+		   memcg->prev_dram_sampled);
+	    memcg->nr_max_sampled >>= 1;
+	}
+    }
+    /* threshold adaptation */
+    else if (memcg->nr_sampled % htmm_adaptation_period == 0) {
+	__adjust_active_threshold(mm, memcg);
+    }
+
+mmap_unlock:
+    mmap_read_unlock(mm);
+put_task:
+    put_pid(pid_struct);
+}
